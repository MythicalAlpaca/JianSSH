#include "jianssh_version.h"

1 ICON "icon.ico"

LANGUAGE 0x09, 0x01
1 VERSIONINFO
FILEVERSION JIANSSH_VERSION_TUPLE
PRODUCTVERSION JIANSSH_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x00040004L // VOS_NT_WINDOWS32
FILETYPE 0x1L       // VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English, Unicode (1200)
        BEGIN
            VALUE "FileDescription", "JianSSH"
            VALUE "FileVersion", JIANSSH_VERSION_STRING
            VALUE "InternalName", "JianSSH"
            VALUE "OriginalFilename", "JianSSH.exe"
            VALUE "ProductName", "JianSSH"
            VALUE "ProductVersion", JIANSSH_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
